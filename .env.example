TAVILY_API_KEY=
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=logs
LOG_FILE=deep-research.log
LOG_AUDIT_FILE=audit.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_INCLUDE_TRACEBACK=false
MODEL_API_KEY=
MODEL_NAME=zai-org/GLM-5.2
MODEL_BASE_URL=https://api.siliconflow.cn/v1
MAIN_AGENT_ENABLE_THINKING=false
RESEARCHER_ENABLE_THINKING=true

# Image analysis (optional; falls back to the main model credentials)
IMAGE_ANALYSIS_ENABLED=true
# Example: Qwen/Qwen3-VL-32B-Instruct (choose a vision-capable model)
IMAGE_ANALYSIS_MODEL_NAME=
IMAGE_ANALYSIS_API_KEY=
IMAGE_ANALYSIS_BASE_URL=
IMAGE_ANALYSIS_TIMEOUT_SECONDS=60

# AI image generation (optional; SiliconFlow OpenAI-compatible image API)
IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_MODEL_NAME=Qwen/Qwen-Image
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://api.siliconflow.cn/v1
IMAGE_GENERATION_TIMEOUT_SECONDS=180
IMAGE_GENERATION_PROMPT_MAX_CHARS=800
IMAGE_GENERATION_MAX_IMAGES=4
MAIN_STREAM_MAX_CHARS=32000
MAIN_STREAM_REPETITION_MIN_CHARS=160
MAIN_STREAM_REPETITION_COUNT=3
AGENT_RECURSION_LIMIT=32
MAX_SEARCH_CALLS=4
MAX_PAGE_READS=6
MAX_PAGE_CHARS=12000
MAX_PARALLEL_RESEARCH_TASKS=2
CHECKPOINT_DB_PATH=deep_research.sqlite
PUBLISHING_DB_PATH=deep_research_publishing.sqlite
HITL_DB_PATH=deep_research_hitl.sqlite
HITL_EXPIRATION_SECONDS=86400
PUBLISHED_SITE_DIR=data/published-site
PUBLIC_SITE_BASE_URL=

# WeChat Official Account (optional; credentials stay outside SQLite/logs)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_AUTHOR=
WECHAT_THUMB_MEDIA_ID=
# draft is the safe first-integration mode; publish submits to WeChat.
WECHAT_PUBLISH_MODE=draft
WECHAT_THEME=minimal

# Xiaohongshu local browser-publishing service (optional)
# Example: http://127.0.0.1:18060
XIAOHONGSHU_BASE_URL=
XIAOHONGSHU_TIMEOUT_SECONDS=30
XIAOHONGSHU_MAX_IMAGES=9
XIAOHONGSHU_TITLE_MAX_LENGTH=20
XIAOHONGSHU_CONTENT_MAX_LENGTH=1000

# Douyin local browser-publishing service (optional)
# Example: http://127.0.0.1:18070
DOUYIN_BASE_URL=
DOUYIN_TIMEOUT_SECONDS=30
DOUYIN_MAX_IMAGES=30
DOUYIN_TITLE_MAX_LENGTH=30

# All configured browser/API publishers poll durable in-flight publications
# after the main service starts.
PUBLICATION_RECOVERY_INTERVAL_SECONDS=30
PUBLICATION_RECOVERY_MAX_ATTEMPTS=12

# Short-term memory
MEMORY_TRIGGER_TOKENS=128000
MEMORY_KEEP_MESSAGES=18
MEMORY_TRIM_TOKENS=4000

RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_PARENT_SIZE=4
RAG_TOP_K=8
RAG_CANDIDATE_K=32
RAG_RRF_K=60
RAG_QUERY_REWRITE_ENABLED=true
RAG_METADATA_WEIGHT=2
RAG_MAX_FILE_BYTES=10000000
RAG_MAX_CONTEXT_CHARS=24000

# Qdrant 存储
RAG_QDRANT_PATH=data/qdrant
RAG_COLLECTION_NAME=deep_research_documents
RAG_REGISTRY_DB_PATH=deep_research_rag.sqlite
RAG_DOCUMENTS_PATH=data/rag/documents
RAG_BM25_DB_PATH=data/rag/bm25.sqlite

# Embedding
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=4096
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_BATCH_SIZE=64

# Long-term memory
MEMORY_DB_PATH=deep_research_memory.sqlite
MEMORY_USER_ID=local-user
MEMORY_USER_MAX_ENTRIES=30
MEMORY_USER_MAX_CHARS=3000
MEMORY_RECALL_LIMIT=3
MEMORY_PAGE_SIZE=20
MEMORY_REVIEW_INTERVAL_TURNS=10
MEMORY_MAX_CANDIDATES=5
MEMORY_PROJECTION_PATH=data/memory_projection
MEMORY_RECALL_MAX_CHARS=6000
